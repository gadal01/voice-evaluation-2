# Copy to .env and fill in. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ELEVENLABS_API_KEY=

# WebSocket auth (see auth.py)
# JWT_SECRET: random, at least 32 characters:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# AUTH_API_KEY: what a client presents to POST /auth/token to get a JWT
AUTH_API_KEY=
